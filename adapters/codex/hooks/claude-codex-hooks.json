{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/codex_adapter.py\" register",
            "timeout": 30,
            "statusMessage": "Registering Axiom completion claim..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/codex_adapter.py\" verify",
            "timeout": 130,
            "statusMessage": "Verifying Axiom completion claim..."
          }
        ]
      }
    ]
  }
}
