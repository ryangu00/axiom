{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/config.schema.json",
  "title": "Axiom project configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "object",
      "description": "Per-rule observe or enforce settings.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "observe",
              "enforce"
            ],
            "default": "observe"
          }
        }
      },
      "default": {},
      "properties": {
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "observe",
                "enforce"
              ]
            },
            "cooldown_minutes": {
              "type": "number",
              "minimum": 0,
              "default": 10
            }
          }
        },
        "stuck-search": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "observe",
                "enforce"
              ]
            },
            "jaccard_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.4
            },
            "failure_threshold": {
              "type": "number",
              "minimum": 1,
              "default": 3
            },
            "window_minutes": {
              "type": "number",
              "minimum": 1,
              "default": 30
            }
          }
        },
        "write-verify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "observe",
                "enforce"
              ]
            }
          }
        },
        "schema-guard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "observe",
                "enforce"
              ]
            },
            "tmp_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "persist_patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
