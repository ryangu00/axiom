{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.invalid/config.schema.json",
  "title": "Axiom project configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rules": {
      "type": "object",
      "description": "Per-rule observe or enforce settings.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["observe", "enforce"],
            "default": "observe"
          }
        }
      },
      "default": {}
    },
    "l1_executors": {
      "type": "object",
      "description": "Reserved for L1 executor configuration.",
      "additionalProperties": true,
      "default": {}
    },
    "l2_evolve": {
      "type": "object",
      "description": "Reserved for L2 evolution configuration.",
      "additionalProperties": true,
      "default": {}
    }
  }
}
